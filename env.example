# Environment configuration (dart-define)
#
# Copy values into your run/build commands. Do NOT commit secrets.
# Production must use HTTPS for API_BASE_URL / PASSENGER_API_BASE_URL / PASSENGER_SOCKET_URL.

API_BASE_URL=http://103.208.181.253:3000
PASSENGER_API_BASE_URL=http://103.208.181.253:3000/api/v1/passenger
PASSENGER_SOCKET_URL=http://103.208.181.253:3000

AUTH0_DOMAIN=dev-5pz66h48u0jnn4sg.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_native_client_id
AUTH0_AUDIENCE=https://api.drivewize.com
AUTH0_CONNECTION=Username-Password-Authentication

# Platform-restricted Maps SDK keys (NOT the backend Google key).
# Android: package name + SHA-1/SHA-256, Maps SDK for Android only.
# iOS: bundle id, Maps SDK for iOS only.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Example run command:
# flutter run \
#   --dart-define=API_BASE_URL=http://103.208.181.253:3000 \
#   --dart-define=PASSENGER_API_BASE_URL=http://103.208.181.253:3000/api/v1/passenger \
#   --dart-define=PASSENGER_SOCKET_URL=http://103.208.181.253:3000 \
#   --dart-define=AUTH0_DOMAIN=dev-5pz66h48u0jnn4sg.us.auth0.com \
#   --dart-define=AUTH0_CLIENT_ID=your_client_id \
#   --dart-define=AUTH0_AUDIENCE=https://api.drivewize.com
#
# Android Maps key (Gradle):
#   echo "GOOGLE_MAPS_API_KEY=your_android_maps_key" >> android/local.properties
#   # or export GOOGLE_MAPS_ANDROID_API_KEY=your_android_maps_key
#
# iOS Maps key (Info.plist GMSApiKey ← xcconfig / env, never hardcode):
#   echo "GOOGLE_MAPS_IOS_API_KEY=your_ios_maps_key" > ios/Flutter/MapsSecrets.xcconfig
#   # or export GOOGLE_MAPS_IOS_API_KEY=your_ios_maps_key
